@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Process Management - Container Diagram

LAYOUT_WITH_LEGEND()

System_Boundary(subsys, "Process Management") {
    Container(scheduler, "Scheduler", "C", "CFS and other scheduling classes")
    Container(fork, "Fork", "C", "Process creation via fork/clone")
    Container(exit, "Exit", "C", "Process termination")
    Container(signal, "Signal", "C", "Signal delivery and handling")
    Container(ptrace, "Ptrace", "C", "Process tracing")
}

System_Ext(other, "Other Subsystems")

Rel(scheduler, fork, "Calls")
Rel(fork, exit, "Calls")
Rel(exit, signal, "Calls")
Rel(signal, ptrace, "Calls")
@enduml